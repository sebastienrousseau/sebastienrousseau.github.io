      "name": "list_message_types",
      "title": "List acmt message types",
      "description": "List every supported ISO 20022 acmt message type and its human name.\n\nUse this first, before any generation or validation call, to discover the\nexact ``message_type`` strings this server accepts (e.g.\n``acmt.001.001.08`` Account Opening Instruction). Do not use it to fetch a\ntype's fields or schema -- call ``get_required_fields`` or\n``get_input_schema`` for that.\n\nReturns a list of ``{\"message_type\": ..., \"name\": ...}`` dictionaries, one\nper supported message type (e.g. ``acmt.001.001.08``).\n",
      "inputSchema": {
        "properties": {},
        "title": "list_message_typesArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
