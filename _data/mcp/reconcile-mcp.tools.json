    {
      "name": "reconcile",
      "description": "Reconcile expected payments against observed bank-statement entries, returning exact matches, short/over payments, split settlements (one-to-many), batch credits (many-to-one) and unmatched residuals, each with an explainable score and reasons.",
      "inputSchema": {
        "properties": {
          "expected": {
            "description": "List of canonical records. Each is an object with 'id' (string) and 'amount' (number) required, plus optional 'currency' (ISO 4217), 'date' (ISO-8601), 'counterparty' (name), 'reference' (remittance/end-to-end id).",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Expected",
            "type": "array"
          },
          "observed": {
            "description": "List of canonical records. Each is an object with 'id' (string) and 'amount' (number) required, plus optional 'currency' (ISO 4217), 'date' (ISO-8601), 'counterparty' (name), 'reference' (remittance/end-to-end id).",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Observed",
            "type": "array"
          },
          "options": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional tuning object: 'abs_tol'/'rel_tol' (amount tolerance), 'date_window_days', 'high_threshold', 'review_threshold', 'currency_strict', 'enable_one_to_many', 'max_combination'.",
            "title": "Options"
          }
        },
        "required": [
          "expected",
          "observed"
        ],
        "title": "reconcileArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "reconcileDictOutput",
        "type": "object"
