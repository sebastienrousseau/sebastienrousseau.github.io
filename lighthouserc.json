{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "url": [
        "http://localhost/index.html",
        "http://localhost/about/index.html",
        "http://localhost/articles/index.html",
        "http://localhost/papers/index.html",
        "http://localhost/projects/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/2026-05-11-lucy-besson-knowledge-transfer-ai-quantum/index.html",
        "http://localhost/fr/index.html",
        "http://localhost/fr/a-propos/index.html",
        "http://localhost/fr/2026-05-11-lucy-besson-transfert-de-connaissances-ia-et-quantique/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance":    ["warn",  { "minScore": 0.90 }],
        "categories:accessibility":  ["error", { "minScore": 1.00 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo":            ["error", { "minScore": 0.95 }],

        "interaction-to-next-paint": "off",
        "total-blocking-time":       ["error", { "maxNumericValue": 200 }],
        "largest-contentful-paint":  ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift":   ["error", { "maxNumericValue": 0.1 }],
        "first-contentful-paint":    ["warn",  { "maxNumericValue": 1800 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
