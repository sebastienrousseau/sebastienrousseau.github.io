{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "url": [
        "http://localhost/index.html",
        "http://localhost/about/index.html",
        "http://localhost/articles/index.html",
        "http://localhost/papers/index.html",
        "http://localhost/projects/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/2026-05-11-lucy-besson-knowledge-transfer-ai-quantum/index.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance":   ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo":           ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
