# --- legacy GitHub Pages mirror, retired 2026-06-10 ---
# Deploys come from the public/ artifact (.github/workflows/ci.yml);
# sigstore bundles moved to sigstore-bundles/. Local docs/ dirs are stale.
docs/

# --- intermediate build snapshot (build.sh) ---
_posts_build/

# --- Lighthouse CI run output (uploaded to LHCI temp storage instead) ---
.lighthouseci/

# --- Rust/WASM build artefacts under labs/ (rebuilt from source by build.sh) ---
labs/*/target/
labs/*/pkg/

# --- jscpd duplication-detector report (local-only) ---
jscpd-report/

# --- local audit artefacts ---
audits/lh/
project-docs/audits/*.md

# --- Cloudflare Worker local state + generated bundle ---
workers/.wrangler/
# Regenerated by .git/bundle-worker.sh
workers/lang-router.bundled.js

# --- local pa11y artefacts (scripts/dev/pa11y-local.sh; CI uses Actions cache) ---
